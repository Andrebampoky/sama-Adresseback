# Valeurs de développement uniquement. Ne pas réutiliser en production.
POSTGRES_DB=samaadresse
POSTGRES_USER=samaadresse_dev
POSTGRES_PASSWORD=change-me-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/samaadresse
SPRING_DATASOURCE_USERNAME=samaadresse_dev
SPRING_DATASOURCE_PASSWORD=change-me-local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Clé de signature des jetons, à générer localement : openssl rand -base64 48
# Laisser vide en développement : une clé éphémère est générée à chaque démarrage.
APP_JWT_SECRET=
# E-mail d'un compte déjà inscrit à promouvoir administrateur au démarrage (facultatif).
APP_BOOTSTRAP_ADMIN_EMAIL=
# URL publique du frontend, utilisée dans les liens envoyés par SMS.
APP_PUBLIC_BASE_URL=http://localhost:5173
# SMS : twilio | simulation | vide. « simulation » n'envoie aucun SMS (tests).
APP_SMS_PROVIDER=
# Identifiants Twilio (utilisez les « test credentials » pour le sandbox). Jamais dans Git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Clé OpenRouteService pour l'itinéraire (vide : fonctionnalité désactivée, 503).
ORS_API_KEY=
# Sans ORS_API_KEY : repli sur un serveur OSRM public gratuit (sans clé). false pour le désactiver.
APP_ROUTING_FALLBACK_ENABLED=true
APP_ROUTING_OSRM_BASE_URL=https://routing.openstreetmap.de
